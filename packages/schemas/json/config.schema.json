{
  "$id": "https://sdlc.local/schemas/config.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "number",
      "const": 1
    },
    "defaultRole": {
      "type": "string",
      "enum": [
        "po",
        "eng"
      ]
    },
    "defaultBranch": {
      "type": "string"
    },
    "codeHost": {
      "type": "string",
      "enum": [
        "local",
        "github",
        "gitlab"
      ]
    },
    "identities": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "roles": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "skillsOwned": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "github": {
            "type": "string",
            "minLength": 1
          },
          "gitlab": {
            "type": "string",
            "minLength": 1
          },
          "subject": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "roles"
        ],
        "additionalProperties": false
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "const": "oidc"
        },
        "issuer": {
          "type": "string",
          "format": "uri"
        },
        "clientId": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "enum": [
            "email",
            "preferred_username",
            "sub"
          ]
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "publicUrl": {
          "type": "string",
          "format": "uri"
        },
        "sessionHours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 720
        }
      },
      "required": [
        "provider",
        "issuer",
        "clientId"
      ],
      "additionalProperties": false
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "thresholds": {
      "type": "object",
      "properties": {
        "autoFilesMax": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "evalPassThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maxLoopRounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sessionCeiling": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "suiteMinSize": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "noDiscriminationRuns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "brokenCheckRuns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "skillPassThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "records": {
      "type": "object",
      "properties": {
        "intent": {
          "type": "string",
          "enum": [
            "repo",
            "external",
            "linked"
          ]
        },
        "spec": {
          "type": "string",
          "enum": [
            "repo",
            "external",
            "linked"
          ]
        },
        "plan": {
          "type": "string",
          "enum": [
            "repo",
            "external",
            "linked"
          ]
        },
        "evals": {
          "type": "string",
          "enum": [
            "repo",
            "external",
            "linked"
          ]
        },
        "pr": {
          "type": "string",
          "enum": [
            "repo",
            "external",
            "linked"
          ]
        },
        "incident": {
          "type": "string",
          "enum": [
            "repo",
            "external",
            "linked"
          ]
        },
        "connector": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "evals": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "continuous",
            "scheduled"
          ]
        },
        "threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "budget": {
          "type": "number",
          "minimum": 0
        },
        "schedule": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "eligibility": {
      "type": "object",
      "properties": {
        "coverage": {
          "type": "string",
          "enum": [
            "strict",
            "lenient"
          ]
        }
      },
      "additionalProperties": false
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "path"
        ],
        "additionalProperties": false
      }
    },
    "intentHome": {
      "type": "string"
    },
    "environments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "preview",
              "staging",
              "production"
            ]
          },
          "description": {
            "type": "string"
          },
          "deploy": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "command"
            ],
            "additionalProperties": false
          },
          "rollback": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "command"
            ],
            "additionalProperties": false
          },
          "healthcheck": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "command"
            ],
            "additionalProperties": false
          },
          "gate": {
            "type": "object",
            "properties": {
              "roles": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                }
              }
            },
            "required": [
              "roles"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "name",
          "kind",
          "deploy",
          "rollback"
        ],
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "intent",
          "spec",
          "plan",
          "evals",
          "pr",
          "incident"
        ]
      }
    },
    "harness": {
      "anyOf": [
        {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "claude-code"
                },
                "bin": {
                  "type": "string",
                  "minLength": 1
                },
                "jobs": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "intent",
                      "design",
                      "plan",
                      "build",
                      "review",
                      "diagnose",
                      "propose"
                    ]
                  }
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "command"
                },
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "command": {
                  "type": "string",
                  "minLength": 1
                },
                "args": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "env": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "jobs": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "intent",
                      "design",
                      "plan",
                      "build",
                      "review",
                      "diagnose",
                      "propose"
                    ]
                  }
                }
              },
              "required": [
                "kind",
                "command"
              ],
              "additionalProperties": false
            }
          ]
        },
        {
          "minItems": 1,
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "claude-code"
                  },
                  "bin": {
                    "type": "string",
                    "minLength": 1
                  },
                  "jobs": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "intent",
                        "design",
                        "plan",
                        "build",
                        "review",
                        "diagnose",
                        "propose"
                      ]
                    }
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "command"
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                  },
                  "command": {
                    "type": "string",
                    "minLength": 1
                  },
                  "args": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "env": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "jobs": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "intent",
                        "design",
                        "plan",
                        "build",
                        "review",
                        "diagnose",
                        "propose"
                      ]
                    }
                  }
                },
                "required": [
                  "kind",
                  "command"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      ]
    }
  },
  "required": [
    "schema",
    "defaultRole",
    "identities"
  ],
  "additionalProperties": false
}
