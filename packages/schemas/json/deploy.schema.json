        "properties": {
          "env": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "preview",
              "staging",
              "production"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "succeeded",
              "failed",
              "rolled_back"
            ]
          },
          "sha": {
            "type": "string",
