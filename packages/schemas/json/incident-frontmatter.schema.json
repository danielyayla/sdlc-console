{
  "$id": "https://sdlc.local/schemas/incident-frontmatter.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^CHG-\\d{4}$"
    },
    "cycle": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "context_manifest": {
      "type": "string"
    },
    "artifact": {
      "type": "string",
      "const": "incident"
    },
    "src": {
      "type": "string",
      "minLength": 1
    },
    "tier": {
      "type": "string",
      "enum": [
        "1σ",
        "2σ",
        "3σ",
        "incident",
        "flaky",
        "eval-retire",
        "skill-trigger",
        "channel"
      ]
    },
    "created": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "schema",
    "id",
    "cycle",
    "artifact",
    "src",
    "tier",
    "created"
  ],
  "additionalProperties": false
}
