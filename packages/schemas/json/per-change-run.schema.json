{
  "$id": "https://sdlc.local/schemas/per-change-run.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "number",
      "const": 1
    },
    "n": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "changeId": {
      "type": "string",
      "pattern": "^CHG-\\d{4}$"
    },
    "cycle": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "worktree": {
      "type": "string"
    },
    "headSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$"
    },
    "fileSet": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "configRef": {
      "type": "object",
      "properties": {
        "claudeMdSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name",
              "version"
            ],
            "additionalProperties": false
          }
        },
        "hooksSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$"
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "claudeMdSha",
        "skills",
        "hooksSha",
        "model"
      ],
      "additionalProperties": false
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "caseId": {
            "type": "string",
            "pattern": "^(CASE|INC)-[A-Za-z0-9][A-Za-z0-9-]*$"
          },
          "pass": {
            "type": "boolean"
          },
          "output": {
            "type": "string"
          }
        },
        "required": [
          "caseId",
          "pass",
          "output"
        ],
        "additionalProperties": false
      }
    },
    "commandResults": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "cmd": {
            "type": "string",
            "minLength": 1
          },
          "exitCode": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "pass": {
            "type": "boolean"
          },
          "output": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "cmd",
          "exitCode",
          "pass",
          "output"
        ],
        "additionalProperties": false
      }
    },
    "verdict": {
      "type": "string",
      "enum": [
        "green",
        "red"
      ]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "schema",
    "n",
    "changeId",
    "cycle",
    "worktree",
    "headSha",
    "fileSet",
    "configRef",
    "results",
    "commandResults",
    "verdict",
    "startedAt"
  ],
  "additionalProperties": false
}
